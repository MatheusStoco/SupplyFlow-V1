# Copie este arquivo para ".env" e preencha. O .env NUNCA vai para o git.

# Desenvolvimento local: True. No Render: não defina (fica False).
DEBUG=True

# Obrigatória quando DEBUG=False. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Sem DATABASE_URL o projeto usa um SQLite local (db.sqlite3).
# PostgreSQL local:  postgres://USUARIO:SENHA@localhost:5432/supplyflow  (e DATABASE_SSL=False)
# Render:            copie a "External Database URL" do painel do Render
DATABASE_URL=
DATABASE_SSL=True

# Endereços aceitos pelo servidor (o do Render é adicionado sozinho)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# E-mail do "Esqueci minha senha". Sem EMAIL_HOST, o e-mail aparece no terminal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SupplyFlow <nao-responda@supplyflow.local>
